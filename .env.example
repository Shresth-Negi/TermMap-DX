# Copy to .env (optional) and edit. No API keys are required: every model runs locally and the
# trained weights are public on Hugging Face (see README). Never commit .env.

# Where the venv, Hugging Face cache and artifacts live. Default: .work/ inside the repo.
# TERMMAP_WORK=/path/to/fast/local/disk/termmap_work

# Hugging Face repo with the trained artifacts (default is set in src/termmap/hub.py)
# TERMMAP_HF_REPO=<namespace>/TermMap-DX

# Override artifact / raw-data directories
# TERMMAP_ARTIFACTS_DIR=$TERMMAP_WORK/artifacts
# TERMMAP_RAW_DIR=./data/raw

# Shared clusters only: hide GPUs unless inside a SLURM allocation
# TERMMAP_HIDE_GPU_OUTSIDE_SLURM=1

# Only if your Hugging Face mirror requires authentication
# HF_TOKEN=
