# No API keys are required: every model runs locally (data never leaves the environment).
# Optional overrides:
# Where the venv, Hugging Face cache and large artifacts live (fast local disk recommended)
TERMMAP_WORK=/path/to/fast/local/disk/termmap_work
# Override artifact / raw-data directories
# TERMMAP_ARTIFACTS_DIR=$TERMMAP_WORK/artifacts
# TERMMAP_RAW_DIR=./data/raw
# Only needed if your HF mirror requires auth for downloads
# HF_TOKEN=
